# Copy this file to .env and replace the placeholder values before starting the app.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nattavault"
# Required in all environments. Use a long random value in production.
AUTH_SECRET="replace-with-a-long-random-secret"
# Leave empty when using AWS S3 directly. Set it for MinIO, Cloudflare R2, DigitalOcean Spaces, and similar providers.
STORAGE_ENDPOINT=""
STORAGE_REGION="auto"
STORAGE_BUCKET="nattavault"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
PUBLIC_SITE_URL="http://localhost:3000"
ADMIN_EMAIL="admin@example.com"
# Use a strong password in real deployments. Do not commit actual credentials.
ADMIN_PASSWORD="change-me-now"
MAX_UPLOAD_BYTES="524288000"
